// FRPC frame metadata. A frame is the 12-byte FRPC header followed by
// `meta_size' bytes holding one of these tables, then the FlatBuffers message
// and the attachment. New fields must be appended; never reorder, renumber or
// remove fields.
//
// After editing, regenerate flatbuffers_rpc_meta_generated.h with
// tools/flatbuffers/gen_rpc_meta.sh.

namespace brpc.policy.frpc;

table RequestMeta {
  service_id:uint32;
  method_id:uint32;
  message_size:uint32;
  attachment_size:uint32;
  correlation_id:uint64;
}

table ResponseMeta {
  error_code:int32;
  message_size:uint32;
  attachment_size:uint32;
  correlation_id:uint64;
}
